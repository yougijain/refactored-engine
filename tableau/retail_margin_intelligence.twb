          <map to='#2e5e8f'><bucket>&quot;Swiftline&quot;</bucket></map>
          <map to='#4a8fbf'><bucket>&quot;Metro Post&quot;</bucket></map>
          <map to='#c1462c'><bucket>&quot;Regional Freight&quot;</bucket></map>
          </encoding>
        </style-rule>
      </style>
        <panes>
          <pane id='1'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings>
            <color column='[federated.ful].[none:carrier:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.ful].[sum:late_net_revenue:qk]</rows>
        <cols>[federated.ful].[tmn:order_month:qk]</cols>
      </table>
      <simple-id uuid="{e83263ef-83b7-5889-9f5f-5ba2bb5c6045}" />
    </worksheet>
    <worksheet name="First-Order Experience">
      <table>
        <view>
          <datasources>
          <datasource caption="Cohort Repeat" name="federated.coh" />
          </datasources>
          <datasource-dependencies datasource='federated.coh'>
          <column datatype='integer' name='[period_index]' role='dimension' type='ordinal' />
          <column datatype='string' name='[first_order_experience]' role='dimension' type='nominal' />
          <column datatype='integer' name='[active_customers]' role='measure' type='quantitative' />
          <column datatype='integer' name='[cohort_customers]' role='measure' type='quantitative' />
          <column caption="Repeat Rate" datatype='real' default-format="p1" name='[Calculation_401]' role='measure' type='quantitative'>
            <calculation class='tableau' formula="SUM([active_customers]) / SUM([cohort_customers])" />
          </column>
          <column-instance column='[period_index]' derivation='None' name='[none:period_index:ok]' pivot='key' type='ordinal' />
          <column-instance column='[first_order_experience]' derivation='None' name='[none:first_order_experience:nk]' pivot='key' type='nominal' />
          <column-instance column='[Calculation_401]' derivation='User' name='[usr:Calculation_401:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
        <filter class='quantitative' column='[federated.coh].[none:period_index:ok]' included-values='in-range'>
          <min>1</min>
          <max>12</max>
        </filter>
        <slices>
          <column>[federated.coh].[none:period_index:ok]</column>
        </slices>
          <aggregation value='true' />
        </view>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[federated.coh].[none:first_order_experience:nk]' palette='custom' type='palette'>
          <map to='#2e7d32'><bucket>&quot;Clean&quot;</bucket></map>
          <map to='#f9a825'><bucket>&quot;Returned&quot;</bucket></map>
          <map to='#ef6c00'><bucket>&quot;Delivered late&quot;</bucket></map>
          <map to='#c62828'><bucket>&quot;Late and returned&quot;</bucket></map>
          </encoding>
        </style-rule>
      </style>
        <panes>
          <pane id='1'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings>
            <color column='[federated.coh].[none:first_order_experience:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.coh].[usr:Calculation_401:qk]</rows>
        <cols>[federated.coh].[none:period_index:ok]</cols>
      </table>
      <simple-id uuid="{30c354cd-be85-5a31-99d6-4481b62cf2d7}" />
    </worksheet>
    <worksheet name="CAC Payback by Channel">
      <table>
        <view>
          <datasources>
          <datasource caption="Channel Payback" name="federated.pay" />
          </datasources>
          <datasource-dependencies datasource='federated.pay'>
          <column datatype='integer' name='[period_index]' role='dimension' type='ordinal' />
          <column datatype='string' name='[acquisition_channel]' role='dimension' type='nominal' />
          <column datatype='integer' name='[cohort_customers]' role='measure' type='quantitative' />
          <column datatype='real' name='[acquisition_spend]' role='measure' type='quantitative' />
          <column datatype='real' name='[cumulative_margin_net_of_cac]' role='measure' type='quantitative' />
          <column caption="Margin net of CAC per Customer" datatype='real' default-format="£#,##0.00" name='[Calculation_502]' role='measure' type='quantitative'>
            <calculation class='tableau' formula="SUM([cumulative_margin_net_of_cac]) / SUM([cohort_customers])" />
          </column>
          <column-instance column='[period_index]' derivation='None' name='[none:period_index:ok]' pivot='key' type='ordinal' />
          <column-instance column='[acquisition_channel]' derivation='None' name='[none:acquisition_channel:nk]' pivot='key' type='nominal' />
          <column-instance column='[Calculation_502]' derivation='User' name='[usr:Calculation_502:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
        <filter class='quantitative' column='[federated.pay].[none:period_index:ok]' included-values='in-range'>
          <min>0</min>
          <max>18</max>
        </filter>
        <slices>
          <column>[federated.pay].[none:period_index:ok]</column>
        </slices>
          <aggregation value='true' />
        </view>
      <style />
        <panes>
          <pane id='1'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings>
            <color column='[federated.pay].[none:acquisition_channel:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.pay].[usr:Calculation_502:qk]</rows>
        <cols>[federated.pay].[none:period_index:ok]</cols>
      </table>
      <simple-id uuid="{bfc21c50-8b9f-5b68-9253-147902b71c13}" />
    </worksheet>
    <worksheet name="Return Reasons by Margin Lost">
      <table>
        <view>
          <datasources>
          <datasource caption="Returns" name="federated.ret" />
          </datasources>
          <datasource-dependencies datasource='federated.ret'>
          <column datatype='string' name='[return_reason]' role='dimension' type='nominal' />
          <column datatype='string' name='[disposition]' role='dimension' type='nominal' />
          <column datatype='string' name='[category]' role='dimension' type='nominal' />
          <column datatype='real' name='[margin_lost]' role='measure' type='quantitative' />
          <column caption="Margin Lost" datatype='real' default-format="£#,##0" name='[Calculation_601]' role='measure' type='quantitative'>
            <calculation class='tableau' formula="SUM([margin_lost])" />
          </column>
          <column-instance column='[return_reason]' derivation='None' name='[none:return_reason:nk]' pivot='key' type='nominal' />
          <column-instance column='[disposition]' derivation='None' name='[none:disposition:nk]' pivot='key' type='nominal' />
          <column-instance column='[category]' derivation='None' name='[none:category:nk]' pivot='key' type='nominal' />
          <column-instance column='[Calculation_601]' derivation='User' name='[usr:Calculation_601:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[federated.ret].[none:disposition:nk]' palette='custom' type='palette'>
          <map to='#4f9d69'><bucket>&quot;Recovered&quot;</bucket></map>
          <map to='#c1462c'><bucket>&quot;Written off&quot;</bucket></map>
          </encoding>
        </style-rule>
      </style>
        <panes>
          <pane id='1'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings>
            <color column='[federated.ret].[none:disposition:nk]' />
            <text column='[federated.ret].[usr:Calculation_601:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.ret].[none:return_reason:nk]</rows>
        <cols>[federated.ret].[usr:Calculation_601:qk]</cols>
      </table>
      <simple-id uuid="{d6b3a351-3c71-5a3e-b34f-82e261ed701e}" />
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="1 · Margin Reality">
      <style />
      <size maxheight='950' maxwidth='1500' minheight='950' minwidth='1500' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
        <zone h='7000' id='2' type-v2='text' w='78000' x='0' y='0'>
          <formatted-text>
            <run bold='true' fontsize='16'>Where the Margin Actually Is</run>
            <run>&#13;&#10;</run>
            <run fontcolor='#5a5a5a' fontsize='10'>Contribution margin after discount, returns and freight - not gross revenue. Use the Margin Basis parameter to switch the first chart between the two.</run>
          </formatted-text>
        </zone>
        <zone h='46000' id='3' name="Category Contribution" w='50000' x='0' y='7000' />
        <zone h='46000' id='4' name="Promised vs Realised Margin" w='50000' x='50000' y='7000' />
        <zone h='47000' id='5' name="Margin Trend by Category" w='100000' x='0' y='53000' />
        <zone h='7000' id='6' param="[Parameters].[Parameter 1]" type-v2='paramctrl' w='22000' x='78000' y='0' />
        </zone>
      </zones>
      <simple-id uuid="{2d7f3276-7628-575f-bc16-c69f764385af}" />
    </dashboard>
    <dashboard name="2 · Pricing &amp; Discounting">
      <style />
      <size maxheight='950' maxwidth='1500' minheight='950' minwidth='1500' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
        <zone h='7000' id='2' type-v2='text' w='100000' x='0' y='0'>
          <formatted-text>
            <run bold='true' fontsize='16'>What Discount Depth Buys</run>
            <run>&#13;&#10;</run>
            <run fontcolor='#5a5a5a' fontsize='10'>Margin per unit and units per line at each discount band, held within category so a mix shift cannot masquerade as elasticity.</run>
          </formatted-text>
        </zone>
        <zone h='93000' id='3' name="Discount Elasticity" w='58000' x='0' y='7000' />
        <zone h='93000' id='4' name="Units per Line by Depth" w='42000' x='58000' y='7000' />
        </zone>
      </zones>
      <simple-id uuid="{c3f8e94e-e071-5666-9e97-19efd504782e}" />
    </dashboard>
    <dashboard name="3 · Fulfilment &amp; Its Cost">
      <style />
      <size maxheight='950' maxwidth='1500' minheight='950' minwidth='1500' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
        <zone h='7000' id='2' type-v2='text' w='100000' x='0' y='0'>
          <formatted-text>
            <run bold='true' fontsize='16'>Late Parcels and What They Cost</run>
            <run>&#13;&#10;</run>
            <run fontcolor='#5a5a5a' fontsize='10'>On-time rate by fulfilment centre and carrier, the revenue riding on the parcels that missed, and the repeat rate of customers whose first order was one of them.</run>
          </formatted-text>
        </zone>
        <zone h='44000' id='3' name="On-Time Rate by Lane" w='42000' x='0' y='7000' />
        <zone h='44000' id='4' name="Revenue on Late Parcels" w='58000' x='42000' y='7000' />
        <zone h='49000' id='5' name="First-Order Experience" w='100000' x='0' y='51000' />
        </zone>
      </zones>
      <simple-id uuid="{1146a60d-76b2-5a3b-b0f4-4b8004826809}" />
    </dashboard>
    <dashboard name="4 · Acquisition &amp; Returns">
      <style />
      <size maxheight='950' maxwidth='1500' minheight='950' minwidth='1500' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
        <zone h='7000' id='2' type-v2='text' w='100000' x='0' y='0'>
          <formatted-text>
            <run bold='true' fontsize='16'>What Each Channel Costs, and What Comes Back</run>
            <run>&#13;&#10;</run>
            <run fontcolor='#5a5a5a' fontsize='10'>Cumulative contribution margin net of acquisition cost per customer, and the return reasons ranked by margin destroyed rather than by unit count.</run>
          </formatted-text>
        </zone>
        <zone h='93000' id='3' name="CAC Payback by Channel" w='58000' x='0' y='7000' />
        <zone h='93000' id='4' name="Return Reasons by Margin Lost" w='42000' x='58000' y='7000' />
        </zone>
      </zones>
      <simple-id uuid="{e01dcc04-b182-567f-a60f-fa1a7053dfbf}" />
    </dashboard>
  </dashboards>
