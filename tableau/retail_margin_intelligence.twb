      <aliases enabled='yes' />
      <column datatype='integer' name='[order_sequence]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[discount_band_rank]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[days_late]' role='dimension' type='ordinal' />
      <column caption="Contribution Margin Rate" datatype='real' default-format="p1" name='[Calculation_101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([contribution_margin]) / SUM([net_revenue])" />
      </column>
      <column caption="Average Order Value" datatype='real' default-format="£#,##0.00" name='[Calculation_102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([net_revenue]) / COUNTD([order_id])" />
      </column>
      <column caption="Margin per Order" datatype='real' default-format="£#,##0.00" name='[Calculation_103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([contribution_margin]) / COUNTD([order_id])" />
      </column>
      <column caption="Return Line Rate" datatype='real' default-format="p1" name='[Calculation_104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM(IIF([is_returned], 1, 0)) / COUNT([order_item_id])" />
      </column>
      <column caption="Freight as % of Revenue" datatype='real' default-format="p1" name='[Calculation_105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([net_shipping_cost]) / SUM([net_revenue])" />
      </column>
      <column caption="Discount as % of Gross" datatype='real' default-format="p1" name='[Calculation_106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([discount_amount]) / SUM([gross_revenue])" />
      </column>
      <column caption="Category Contribution Share" datatype='real' default-format="p1" name='[Calculation_107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([contribution_margin]) / TOTAL(SUM([contribution_margin]))" />
      </column>
      <column caption="Margin Basis" datatype='real' default-format="£#,##0" name='[Calculation_108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="IF [Parameters].[Parameter 1] = 'Contribution Margin' THEN SUM([contribution_margin]) ELSE SUM([net_revenue]) END" />
      </column>
    </datasource>
