          <column datatype='real' name='[current_mrr]' role='measure' type='quantitative' />
          <column-instance column='[company_name]' derivation='None' name='[none:company_name:nk]' pivot='key' type='nominal' />
          <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
          <column-instance column='[latest_plan_name]' derivation='None' name='[none:latest_plan_name:nk]' pivot='key' type='nominal' />
          <column-instance column='[latest_risk_tier]' derivation='None' name='[none:latest_risk_tier:nk]' pivot='key' type='nominal' />
          <column-instance column='[is_active]' derivation='None' name='[none:is_active:ok]' pivot='key' type='ordinal' />
          <column-instance column='[current_mrr]' derivation='Sum' name='[sum:current_mrr:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
        <filter class='categorical' column='[federated.dim].[none:is_active:ok]'>
