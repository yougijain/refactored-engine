        <calculation class='tableau' formula="AVG([churned_within_90_days])" />
      </column>
      <column caption="Seat Utilisation" datatype='real' default-format="p1" name='[Calculation_402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([active_users]) / SUM([licensed_seats])" />
      </column>
      <column caption="MRR at Risk" datatype='real' default-format="$#,##0" name='[Calculation_403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM(IIF([risk_tier] = 'At Risk' OR [risk_tier] = 'Critical', [mrr], 0))" />
      </column>
