      <aliases enabled='yes' />
      <column datatype='integer' name='[tenure_months]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[is_active]' role='dimension' type='ordinal' />
      <column caption="Signed Movement MRR" datatype='real' default-format="$#,##0" name='[Calculation_101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="[new_mrr] + [expansion_mrr] + [reactivation_mrr] - [contraction_mrr] - [churned_mrr]" />
      </column>
      <column caption="Active Customers" datatype='integer' name='[Calculation_102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="COUNTD(IF [is_active] = 1 THEN [customer_id] END)" />
      </column>
      <column caption="ARPA" datatype='real' default-format="$#,##0" name='[Calculation_103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([mrr]) / COUNTD(IF [is_active] = 1 THEN [customer_id] END)" />
      </column>
      <column caption="Account Peak MRR" datatype='real' default-format="$#,##0" name='[Calculation_104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="{ FIXED [customer_id] : MAX([mrr]) }" />
      </column>
      <column caption="Expansion Rate" datatype='real' default-format="p1" name='[Calculation_105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([expansion_mrr]) / SUM([prior_mrr])" />
      </column>
      <column caption="Gross MRR Churn Rate" datatype='real' default-format="p1" name='[Calculation_106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([churned_mrr]) / SUM([prior_mrr])" />
      </column>
    </datasource>
