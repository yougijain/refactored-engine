          <map to='#2e7d32'><bucket>&quot;Healthy&quot;</bucket></map>
          <map to='#f9a825'><bucket>&quot;Watch&quot;</bucket></map>
          <map to='#ef6c00'><bucket>&quot;At Risk&quot;</bucket></map>
