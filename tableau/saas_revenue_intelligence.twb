  <worksheets>
    <worksheet name="MRR Trend by Segment">
      <table>
        <view>
          <datasources>
          <datasource caption="MRR Movement" name="federated.mrr" />
          </datasources>
          <datasource-dependencies datasource='federated.mrr'>
          <column datatype='date' name='[month]' role='dimension' type='ordinal' />
          <column datatype='string' name='[segment]' role='dimension' type='nominal' />
          <column datatype='real' name='[mrr]' role='measure' type='quantitative' />
          <column-instance column='[month]' derivation='Month' name='[tmn:month:qk]' pivot='key' type='quantitative' />
          <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
          <column-instance column='[mrr]' derivation='Sum' name='[sum:mrr:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[federated.mrr].[none:segment:nk]' palette='custom' type='palette'>
          <map to='#1f4e79'><bucket>&quot;Enterprise&quot;</bucket></map>
          <map to='#2e75b6'><bucket>&quot;Mid-Market&quot;</bucket></map>
          <map to='#9dc3e6'><bucket>&quot;SMB&quot;</bucket></map>
          </encoding>
        </style-rule>
      </style>
        <panes>
          <pane id='1'>
            <view><breakdown value='auto' /></view>
            <mark class='Area' />
            <encodings>
            <color column='[federated.mrr].[none:segment:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.mrr].[sum:mrr:qk]</rows>
        <cols>[federated.mrr].[tmn:month:qk]</cols>
      </table>
      <simple-id uuid="{69bad5a4-c147-511f-85be-582952b2bc93}" />
    </worksheet>
    <worksheet name="MRR Movement Bridge">
      <table>
        <view>
          <datasources>
          <datasource caption="MRR Movement" name="federated.mrr" />
          </datasources>
          <datasource-dependencies datasource='federated.mrr'>
          <column datatype='date' name='[month]' role='dimension' type='ordinal' />
          <column datatype='string' name='[movement_type]' role='dimension' type='nominal' />
          <column datatype='real' name='[new_mrr]' role='measure' type='quantitative' />
          <column datatype='real' name='[expansion_mrr]' role='measure' type='quantitative' />
          <column datatype='real' name='[reactivation_mrr]' role='measure' type='quantitative' />
          <column datatype='real' name='[contraction_mrr]' role='measure' type='quantitative' />
          <column datatype='real' name='[churned_mrr]' role='measure' type='quantitative' />
          <column caption="Signed Movement MRR" datatype='real' default-format="$#,##0" name='[Calculation_101]' role='measure' type='quantitative'>
            <calculation class='tableau' formula="[new_mrr] + [expansion_mrr] + [reactivation_mrr] - [contraction_mrr] - [churned_mrr]" />
          </column>
          <column-instance column='[month]' derivation='Month' name='[tmn:month:qk]' pivot='key' type='quantitative' />
          <column-instance column='[movement_type]' derivation='None' name='[none:movement_type:nk]' pivot='key' type='nominal' />
          <column-instance column='[Calculation_101]' derivation='Sum' name='[sum:Calculation_101:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[federated.mrr].[none:movement_type:nk]' palette='custom' type='palette'>
          <map to='#2e7d32'><bucket>&quot;New&quot;</bucket></map>
          <map to='#66bb6a'><bucket>&quot;Expansion&quot;</bucket></map>
          <map to='#a5d6a7'><bucket>&quot;Reactivation&quot;</bucket></map>
          <map to='#ef9a9a'><bucket>&quot;Contraction&quot;</bucket></map>
          <map to='#c62828'><bucket>&quot;Churn&quot;</bucket></map>
          <map to='#bdbdbd'><bucket>&quot;Retained&quot;</bucket></map>
          </encoding>
        </style-rule>
      </style>
        <panes>
          <pane id='1'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings>
            <color column='[federated.mrr].[none:movement_type:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.mrr].[sum:Calculation_101:qk]</rows>
        <cols>[federated.mrr].[tmn:month:qk]</cols>
      </table>
      <simple-id uuid="{d79a6318-9f3a-5001-9a47-c7e690663446}" />
    </worksheet>
    <worksheet name="Net Revenue Retention (TTM)">
      <table>
        <view>
          <datasources>
          <datasource caption="Retention TTM" name="federated.ttm" />
          </datasources>
          <datasource-dependencies datasource='federated.ttm'>
          <column datatype='date' name='[month]' role='dimension' type='ordinal' />
          <column datatype='string' name='[segment]' role='dimension' type='nominal' />
          <column datatype='real' name='[base_mrr]' role='measure' type='quantitative' />
          <column datatype='real' name='[retained_mrr]' role='measure' type='quantitative' />
          <column datatype='real' name='[retained_mrr_capped]' role='measure' type='quantitative' />
          <column caption="Net Revenue Retention (TTM)" datatype='real' default-format="p1" name='[Calculation_601]' role='measure' type='quantitative'>
            <calculation class='tableau' formula="SUM([retained_mrr]) / SUM([base_mrr])" />
          </column>
          <column-instance column='[month]' derivation='Month' name='[tmn:month:qk]' pivot='key' type='quantitative' />
          <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
          <column-instance column='[Calculation_601]' derivation='User' name='[usr:Calculation_601:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[federated.ttm].[none:segment:nk]' palette='custom' type='palette'>
          <map to='#1f4e79'><bucket>&quot;Enterprise&quot;</bucket></map>
          <map to='#2e75b6'><bucket>&quot;Mid-Market&quot;</bucket></map>
          <map to='#9dc3e6'><bucket>&quot;SMB&quot;</bucket></map>
          </encoding>
        </style-rule>
      </style>
        <panes>
          <pane id='1'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings>
            <color column='[federated.ttm].[none:segment:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.ttm].[usr:Calculation_601:qk]</rows>
        <cols>[federated.ttm].[tmn:month:qk]</cols>
      </table>
      <simple-id uuid="{39871cf9-2e0d-5f72-9d90-1e3f86e5f882}" />
    </worksheet>
    <worksheet name="Cohort Retention Triangle">
      <table>
        <view>
          <datasources>
          <datasource caption="Cohort Retention" name="federated.coh" />
          <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource='federated.coh'>
          <column datatype='date' name='[cohort_month]' role='dimension' type='ordinal' />
          <column datatype='integer' name='[period_index]' role='dimension' type='ordinal' />
          <column datatype='integer' name='[active_customers]' role='measure' type='quantitative' />
          <column datatype='integer' name='[cohort_customers]' role='measure' type='quantitative' />
          <column datatype='real' name='[retained_mrr]' role='measure' type='quantitative' />
          <column datatype='real' name='[cohort_initial_mrr]' role='measure' type='quantitative' />
          <column caption="Cohort Metric" datatype='real' default-format="p1" name='[Calculation_303]' role='measure' type='quantitative'>
            <calculation class='tableau' formula="IF [Parameters].[Parameter 1] = 'Logo Retention' THEN SUM([active_customers]) / SUM([cohort_customers]) ELSE SUM([retained_mrr]) / SUM([cohort_initial_mrr]) END" />
          </column>
          <column-instance column='[cohort_month]' derivation='MonthYear' name='[my:cohort_month:ok]' pivot='key' type='ordinal' />
          <column-instance column='[period_index]' derivation='None' name='[none:period_index:ok]' pivot='key' type='ordinal' />
          <column-instance column='[Calculation_303]' derivation='User' name='[usr:Calculation_303:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Cohort Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Logo Retention&quot;'>
              <calculation class='tableau' formula='&quot;Logo Retention&quot;' />
              <members>
                <member value='&quot;Logo Retention&quot;' />
                <member value='&quot;Net Revenue Retention&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
      <style />
        <panes>
          <pane id='1'>
            <view><breakdown value='auto' /></view>
            <mark class='Square' />
            <encodings>
            <color column='[federated.coh].[usr:Calculation_303:qk]' />
            <text column='[federated.coh].[usr:Calculation_303:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.coh].[my:cohort_month:ok]</rows>
        <cols>[federated.coh].[none:period_index:ok]</cols>
      </table>
      <simple-id uuid="{777fdd6e-5b6c-5064-80b2-d079cf49d848}" />
    </worksheet>
    <worksheet name="Churned MRR by Reason">
      <table>
        <view>
          <datasources>
          <datasource caption="MRR Movement" name="federated.mrr" />
          </datasources>
          <datasource-dependencies datasource='federated.mrr'>
          <column datatype='string' name='[churn_reason]' role='dimension' type='nominal' />
          <column datatype='string' name='[movement_type]' role='dimension' type='nominal' />
          <column datatype='string' name='[segment]' role='dimension' type='nominal' />
          <column datatype='real' name='[churned_mrr]' role='measure' type='quantitative' />
          <column-instance column='[churn_reason]' derivation='None' name='[none:churn_reason:nk]' pivot='key' type='nominal' />
          <column-instance column='[movement_type]' derivation='None' name='[none:movement_type:nk]' pivot='key' type='nominal' />
          <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
          <column-instance column='[churned_mrr]' derivation='Sum' name='[sum:churned_mrr:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
        <filter class='categorical' column='[federated.mrr].[none:movement_type:nk]'>
          <groupfilter function='union' user:op='manual'>
          <groupfilter function='member' level='[none:movement_type:nk]' member='"Churn"' />
          </groupfilter>
        </filter>
        <slices>
          <column>[federated.mrr].[none:movement_type:nk]</column>
        </slices>
          <aggregation value='true' />
        </view>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[federated.mrr].[none:segment:nk]' palette='custom' type='palette'>
          <map to='#1f4e79'><bucket>&quot;Enterprise&quot;</bucket></map>
          <map to='#2e75b6'><bucket>&quot;Mid-Market&quot;</bucket></map>
          <map to='#9dc3e6'><bucket>&quot;SMB&quot;</bucket></map>
          </encoding>
        </style-rule>
      </style>
        <panes>
          <pane id='1'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings>
            <color column='[federated.mrr].[none:segment:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.mrr].[none:churn_reason:nk]</rows>
        <cols>[federated.mrr].[sum:churned_mrr:qk]</cols>
      </table>
      <simple-id uuid="{352dc4f8-d4f7-58c2-8fc4-c0f5fd5429c0}" />
    </worksheet>
    <worksheet name="Churn Risk by Health Tier">
      <table>
        <view>
          <datasources>
          <datasource caption="Account Health" name="federated.hea" />
          </datasources>
          <datasource-dependencies datasource='federated.hea'>
          <column datatype='string' name='[risk_tier]' role='dimension' type='nominal' />
          <column datatype='integer' name='[risk_tier_rank]' role='dimension' type='ordinal' />
          <column datatype='integer' name='[churned_within_90_days]' role='measure' type='quantitative' />
          <column caption="90-Day Churn Rate" datatype='real' default-format="p1" name='[Calculation_401]' role='measure' type='quantitative'>
            <calculation class='tableau' formula="AVG([churned_within_90_days])" />
          </column>
          <column-instance column='[risk_tier]' derivation='None' name='[none:risk_tier:nk]' pivot='key' type='nominal' />
          <column-instance column='[risk_tier_rank]' derivation='None' name='[none:risk_tier_rank:ok]' pivot='key' type='ordinal' />
          <column-instance column='[Calculation_401]' derivation='User' name='[usr:Calculation_401:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[federated.hea].[none:risk_tier:nk]' palette='custom' type='palette'>
          <map to='#2e7d32'><bucket>&quot;Healthy&quot;</bucket></map>
          <map to='#f9a825'><bucket>&quot;Watch&quot;</bucket></map>
          <map to='#ef6c00'><bucket>&quot;At Risk&quot;</bucket></map>
          <map to='#c62828'><bucket>&quot;Critical&quot;</bucket></map>
          </encoding>
        </style-rule>
      </style>
        <panes>
          <pane id='1'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings>
            <color column='[federated.hea].[none:risk_tier:nk]' />
            <text column='[federated.hea].[usr:Calculation_401:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.hea].[usr:Calculation_401:qk]</rows>
        <cols>([federated.hea].[none:risk_tier_rank:ok] / [federated.hea].[none:risk_tier:nk])</cols>
      </table>
      <simple-id uuid="{2cc56a82-ae43-5a89-b6ac-d73967082194}" />
    </worksheet>
    <worksheet name="Account Matrix">
