            <remote-name>expanded_customers</remote-name>
            <remote-type>20</remote-type>
            <local-name>[expanded_customers]</local-name>
            <parent-name>[fct_retention_monthly#csv]</parent-name>
            <remote-alias>expanded_customers</remote-alias>
            <ordinal>16</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>contracted_customers</remote-name>
            <remote-type>20</remote-type>
            <local-name>[contracted_customers]</local-name>
            <parent-name>[fct_retention_monthly#csv]</parent-name>
            <remote-alias>contracted_customers</remote-alias>
            <ordinal>17</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column caption="Net Revenue Retention (MoM)" datatype='real' default-format="p1" name='[Calculation_201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([retention_base_ending_mrr]) / SUM([retention_base_mrr])" />
      </column>
      <column caption="Gross Revenue Retention (MoM)" datatype='real' default-format="p1" name='[Calculation_202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="(SUM([retention_base_mrr]) - SUM([churned_mrr]) - SUM([contraction_mrr])) / SUM([retention_base_mrr])" />
      </column>
      <column caption="Logo Churn Rate (monthly)" datatype='real' default-format="p1" name='[Calculation_203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([churned_customers]) / SUM([starting_customers])" />
      </column>
      <column caption="Net New MRR" datatype='real' default-format="$#,##0" name='[Calculation_204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([new_mrr]) + SUM([expansion_mrr]) + SUM([reactivation_mrr]) - SUM([contraction_mrr]) - SUM([churned_mrr])" />
      </column>
      <column caption="ARR" datatype='real' default-format="$#,##0" name='[Calculation_205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([ending_mrr]) * 12" />
      </column>
      <column caption="SaaS Quick Ratio" datatype='real' default-format="n2" name='[Calculation_206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="(SUM([new_mrr]) + SUM([expansion_mrr]) + SUM([reactivation_mrr])) / IIF(SUM([contraction_mrr]) + SUM([churned_mrr]) = 0, NULL, SUM([contraction_mrr]) + SUM([churned_mrr]))" />
      </column>
    </datasource>
